{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20
  },
  "configurePresets": [
    {
      "name": "build",
      "displayName": "Build for NRF5340 SENSEIv1 APP",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "BOARD": "nrf5340_senseiv1/nrf5340/cpuapp",
        "EXTRA_ZEPHYR_MODULES": "$env{SENSEI_SDK_ROOT}/NRF",
        "CACHED_CONF_FILE": "${sourceDir}/prj.conf"
      }
    }
  ]
}
