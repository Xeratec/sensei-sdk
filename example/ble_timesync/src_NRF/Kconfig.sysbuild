# The network core runs the NCS ipc_radio image (Bluetooth controller, HCI over IPC).
# Its settings are in sysbuild/ipc_radio.conf.
config NRF_DEFAULT_IPC_RADIO
	default y

config NETCORE_IPC_RADIO_BT_HCI_IPC
	default y

source "share/sysbuild/Kconfig"
