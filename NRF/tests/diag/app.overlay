/* native_sim has no retained RAM: a test driver (src/test_retained_mem.c) keeps it in an array. The areas are the
 * ones of the SENSEI boards. */
/ {
	retained: test-retained-mem {
		compatible = "sensei,test-retained-mem";
		size = <1024>;
		#address-cells = <1>;
		#size-cells = <1>;

		diag_fault: diag_fault@0 {
			compatible = "zephyr,retention";
			status = "okay";
			reg = <0x0 0x40>;
		};
		diag_state: diag_state@40 {
			compatible = "zephyr,retention";
			status = "okay";
			reg = <0x40 0x10>;
		};
		diag_dump: diag_dump@80 {
			compatible = "zephyr,retention";
			status = "okay";
			reg = <0x80 0x380>;
		};
	};

	chosen {
		sensei,diag-fault = &diag_fault;
		sensei,diag-state = &diag_state;
		sensei,diag-dump = &diag_dump;
	};
};
