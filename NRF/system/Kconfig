menu "System"

menuconfig SENSEI_COMM
	bool "Enable the SENSEI Communication Subsystem"
	default n
	depends on SENSEI
	help
	  Enable the SENSEI Communication Subsystem.

menuconfig SENSEI_PWR
	bool "Enable the SENSEI Power Subsystem"
	default n
	depends on SENSEI
	select SENSEI_PWR_MATH
	help
	  Enable the SENSEI Power Subsystem.

rsource "pwr/Kconfig"
rsource "crypto/Kconfig"
rsource "ota/Kconfig"
rsource "marker/Kconfig"
rsource "wdt/Kconfig"
rsource "diag/Kconfig"

endmenu
