if BOARD_SENSEI_LPWAN_NRF9151 || BOARD_SENSEI_LPWAN_NRF9151_NS

config BOARD
	default "sensei_lpwan_nrf9151"

# The secure image is linked into the code partition from the devicetree if MCUboot loads it.
DT_CHOSEN_Z_CODE_PARTITION := zephyr,code-partition

config FLASH_LOAD_SIZE
	default $(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_CODE_PARTITION))
	depends on BOARD_SENSEI_LPWAN_NRF9151 && TRUSTED_EXECUTION_SECURE

if BOARD_SENSEI_LPWAN_NRF9151_NS

config FLASH_LOAD_OFFSET
	default $(dt_chosen_reg_addr_hex,$(DT_CHOSEN_Z_CODE_PARTITION))

config FLASH_LOAD_SIZE
	default $(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_CODE_PARTITION))

endif # BOARD_SENSEI_LPWAN_NRF9151_NS

endif # BOARD_SENSEI_LPWAN_NRF9151 || BOARD_SENSEI_LPWAN_NRF9151_NS
