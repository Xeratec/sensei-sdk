mainmenu "SENSEI LPWAN service (nRF9151)"

config LPWAN_SHIELD_SIM
	bool "Simulated shield on native_sim (link over a socket, fake LTE modem and LR1121)"
	depends on BOARD_NATIVE_SIM
	select SENSEI_LPWAN_SIM_HOST
	help
	  For tests without hardware: the SPI link is a TCP connection to the simulated node, the modem library, lte_lc and
	  the LR1121 driver are fakes (sim/), the LTE socket is a host socket. See sim/README.md.

config LPWAN_SHIELD_LTE
	bool "LTE-M and NB-IoT"
	default y
	select NETWORKING
	select NET_SOCKETS
	select NET_SOCKETS_OFFLOAD
	select NET_SOCKETS_POSIX_NAMES
	select NRF_MODEM_LIB if !LPWAN_SHIELD_SIM
	select LTE_LINK_CONTROL if !LPWAN_SHIELD_SIM
	select LTE_LC_PSM_MODULE if !LPWAN_SHIELD_SIM
	select LTE_LC_EDRX_MODULE if !LPWAN_SHIELD_SIM
	# modem sleep events: LpwanStatus.psm_entries counts the PSM entries
	select LTE_LC_MODEM_SLEEP_MODULE if !LPWAN_SHIELD_SIM
	select LTE_LC_MODEM_SLEEP_NOTIFICATIONS if !LPWAN_SHIELD_SIM
	select DATE_TIME if !LPWAN_SHIELD_SIM
	help
	  UDP or TCP uplink and downlink over the LTE modem. The modem library starts at the first
	  connect request.

# The modem reports a sleep only when it lasts this long: the shortest value, so that every PSM counts.
config LTE_LC_MODEM_SLEEP_NOTIFICATIONS_THRESHOLD_MS
	default 10240 if LPWAN_SHIELD_LTE

config LPWAN_SHIELD_LORA
	bool "LoRaWAN on the LR1121 (Modem-E firmware)"
	default y
	help
	  LoRaWAN class A (class C on request), OTAA, over the LR1121 on the shield.

if LPWAN_SHIELD_LTE

config LPWAN_SHIELD_LTE_STACK
	int "LTE worker stack size"
	default 4096

config LPWAN_SHIELD_LTE_CONNECT_TIMEOUT_S
	int "Time to wait for the network registration, s"
	default 600

config LPWAN_SHIELD_LTE_TIME_WAIT_S
	int "Time to wait for the network time after connect, s"
	default 10

config LPWAN_SHIELD_RAI
	bool "Release assistance indication (RAI) on the last chunk of an LTE message"
	default y
	select LTE_LC_RAI_MODULE if !LPWAN_SHIELD_SIM
	select LTE_RAI_REQ if !LPWAN_SHIELD_SIM
	help
	  The client marks the last chunk of a message (Send.rai); the shield sets the RAI socket option for that send
	  and, if the server is expected to answer, waits for the answer and then tells the modem that nothing more is
	  coming. The modem leaves the connected state at once and not after the network's inactivity timer. Whether the
	  network acts on it depends on the operator: see LpwanStatus.rai_support. Without it the option is never set.

config LPWAN_SHIELD_LTE_ANSWER_WAIT_S
	int "Time to wait for the answer of the server after the last chunk (one-response RAI), LTE-M, s"
	default 10
	range 1 35
	depends on LPWAN_SHIELD_RAI
	help
	  The collector answers every LTE uplink with one datagram (a downlink or a 3-byte ack). The time counts from
	  send(), so it includes the RRC set-up of the modem (about 3 s on LTE-M). Without an answer in this time the send
	  is reported as "sent, unconfirmed" (TxDone.unconfirmed, ok is true), not as a failure, and the modem is told
	  that nothing more is expected. The wait ends early when the coverage is lost.

config LPWAN_SHIELD_LTE_ANSWER_WAIT_NBIOT_S
	int "The same for NB-IoT, s"
	default 30
	range 1 35
	depends on LPWAN_SHIELD_RAI
	help
	  NB-IoT at coverage level 1 and 2 repeats every transmission, so a 1 kB uplink and its answer can take 10 to 30 s.
	  Both waits plus 10 s must stay below LPWAN_SHIELD_SEND_TIMEOUT_S.

config LPWAN_SHIELD_LTE_EVAL
	bool "Connection evaluation (%CONEVAL) on request of the client"
	default y
	select LTE_LC_CONN_EVAL_MODULE if !LPWAN_SHIELD_SIM
	help
	  The client asks before a send that can wait (lte_eval); the result (energy estimate, RSRP, coverage level) is an
	  event. The node defers non-urgent data when the estimate is bad.

config LPWAN_SHIELD_GNSS
	bool "GNSS of the nRF9151: one fix on request"
	default y
	select MODEM_ANTENNA if !LPWAN_SHIELD_SIM
	help
	  The nRF5340 asks for a fix (gnss_fix) and gets position, time and time to fix as an event. GNSS is in the system mode
	  of the modem (LTE-M or NB-IoT with GPS) and active (functional mode 31) only for an attempt; it also works with LTE
	  off. It runs only while LTE is idle (PSM, eDRX gaps, LTE off). The active antenna of the shield is supplied
	  through the modem's COEX0 pin (AT%XCOEX0, set by the NCS library modem_antenna). No A-GNSS. Needs the modem
	  library, so it comes with LPWAN_SHIELD_LTE. See README.md.
	depends on LPWAN_SHIELD_LTE

if LPWAN_SHIELD_GNSS

config LPWAN_SHIELD_GNSS_STACK
	int "GNSS worker stack size"
	default 2560

# COEX0 switches the supply of the GNSS antenna (EN_3V3_GNSS_ANT, load switch U5): high while GNSS is active in
# 1565 to 1586 MHz. This is the string of Nordic's modem_antenna library for an antenna with an LNA that COEX0 controls
# (what the library calls the "onboard" case). No MAGPIO: the shield has no antenna tuner on those pins.
config MODEM_ANTENNA_AT_COEX0
	default "AT\%XCOEX0=1,1,1565,1586"

endif # LPWAN_SHIELD_GNSS

config LPWAN_SHIELD_PROPRIETARY_PSM
	bool "Proprietary PSM when the network grants no PSM"
	default y
	select LTE_PROPRIETARY_PSM_REQ if !LPWAN_SHIELD_SIM
	help
	  The modem sleeps as in PSM although the network did not grant it (AT%FEACONF). It acts only when the
	  network grants no PSM. Needs a modem firmware that has it (mfw_nrf91x1); on others the request is ignored.

endif # LPWAN_SHIELD_LTE

if LPWAN_SHIELD_LORA

config LPWAN_SHIELD_LORA_STACK
	int "LoRa worker stack size"
	default 3072

config LPWAN_SHIELD_LORA_JOIN_ATTEMPTS
	int "Join attempts before giving up"
	default 10

config LPWAN_SHIELD_LORA_TX_OFFSET_DB
	int "TX power offset of the RF path, dB"
	default -2
	help
	  Compensation for the shield's RF switch and matching, found during commissioning.

endif # LPWAN_SHIELD_LORA

config LPWAN_SHIELD_SEND_TIMEOUT_S
	int "Time for a send to report its result before it is failed, s"
	default 45
	help
	  Without a tx_done the state machine would stay in SENDING and every later send would be refused.
	  Used when the backend has no estimate (LTE). A LoRa send is given the time the LR1121 needs (duty-cycle wait,
	  transmissions with their repeats, at most 10 min) plus 5 s, if that is longer. While the LR1121 still holds the
	  frame the send is not failed then; the LR1121 is reset after twice that time. The client waits 15 s more at the least
	  (SENSEI_LPWAN_TX_TIMEOUT_S, 60 s), so this side answers first.

config LPWAN_SHIELD_DFU
	bool "Update over the air: the app (MCUboot) and the modem firmware (delta)"
	default y
	depends on BOOTLOADER_MCUBOOT
	select FLASH
	select FLASH_MAP
	select STREAM_FLASH
	select IMG_MANAGER
	help
	  The nRF5340 sends the new image over the SPI link (lpwan.proto, dfu_* requests); the app writes it into the
	  second MCUboot slot, or hands a delta patch to the modem. The new app confirms itself after the handshake with the
	  nRF5340 (dfu_confirm). Needs MCUboot from sysbuild (sysbuild.conf). See README.md.

config LPWAN_SHIELD_MODEM_DFU
	bool "Modem firmware update (nrf_modem_delta_dfu)"
	default y
	depends on LPWAN_SHIELD_DFU && LPWAN_SHIELD_LTE

config LPWAN_SHIELD_MODEM_DFU_STACK
	int "Stack of the work queue that starts the modem library and runs the modem update"
	default 3072
	depends on LPWAN_SHIELD_MODEM_DFU

config LPWAN_SHIELD_DFU_HOLD_S
	int "Time an update sender may be quiet before the radios are free again, s"
	default 150
	range 30 3600
	depends on LPWAN_SHIELD_DFU
	help
	  While a transfer is open the radios stay idle (flash, CPU). If no update request came for this long the sender
	  is gone: the radios work again. The transfer stays and can be resumed. Longer than the 120 s after which the
	  nRF5340 ends its update session. A running modem update holds the radios whatever this says.

config LPWAN_SHIELD_CONFIRM_DELAY_S
	int "Run time before a new app image confirms itself, s"
	default 5
	range 1 600
	depends on LPWAN_SHIELD_DFU
	help
	  After an update the image runs on trial. It confirms itself when it has run this long and the nRF5340 has
	  accepted the handshake (dfu_confirm for this image, sent after the protocol, the update support and a status
	  request were checked, and sent again until the image has confirmed).

config LPWAN_SHIELD_TRIAL_TIMEOUT_S
	int "Trial time of a new app image, s"
	default 180
	range 30 3600
	depends on LPWAN_SHIELD_DFU
	help
	  If the image is still unconfirmed after this time (the nRF5340 did not accept it), the shield resets and MCUboot
	  goes back to the old image. Any reset or power cycle of an unconfirmed image does the same.

config LPWAN_SHIELD_LINK_STACK
	int "SPI link thread stack size"
	default 3072 if LPWAN_SHIELD_DFU
	default 2048
	help
	  The update runs on this thread (flash writes, the read-back hash): it needs the larger size.

config LPWAN_SHIELD_LINK_PRIO
	int "SPI link thread priority (preemptible, lower is higher)"
	default 2

config LPWAN_SHIELD_WORKER_PRIO
	int "Priority of the LTE and LoRa workers (lower is higher)"
	default 6

config LPWAN_SHIELD_LOG_LEVEL
	int "Log level of the service modules (0 off ... 4 debug)"
	default 3

# A modem fault resets the chip (main.c). The choice is only there with the modem library.
choice NRF_MODEM_LIB_ON_FAULT
	default NRF_MODEM_LIB_ON_FAULT_APPLICATION_SPECIFIC
endchoice

source "Kconfig.zephyr"
