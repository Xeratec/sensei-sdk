mainmenu "SENSEI LPWAN service (nRF9151)"

config LPWAN_SHIELD_LTE
	bool "LTE-M and NB-IoT"
	default y
	select NETWORKING
	select NET_SOCKETS
	select NET_SOCKETS_OFFLOAD
	select NET_SOCKETS_POSIX_NAMES
	select NRF_MODEM_LIB
	select LTE_LINK_CONTROL
	select LTE_LC_PSM_MODULE
	select LTE_LC_EDRX_MODULE
	select DATE_TIME
	help
	  UDP or TCP uplink and downlink over the LTE modem. The modem library starts at the first
	  connect request.

config LPWAN_SHIELD_LORA
	bool "LoRaWAN on the LR1121 (Modem-E firmware)"
	default y
	help
	  LoRaWAN class A (class C on request), OTAA, over the LR1121 on the shield.

if LPWAN_SHIELD_LTE

config LPWAN_SHIELD_LTE_STACK
	int "LTE worker stack size"
	default 4096

config LPWAN_SHIELD_LTE_CONNECT_TIMEOUT_S
	int "Time to wait for the network registration, s"
	default 600

config LPWAN_SHIELD_LTE_TIME_WAIT_S
	int "Time to wait for the network time after connect, s"
	default 10

endif # LPWAN_SHIELD_LTE

if LPWAN_SHIELD_LORA

config LPWAN_SHIELD_LORA_STACK
	int "LoRa worker stack size"
	default 3072

config LPWAN_SHIELD_LORA_JOIN_ATTEMPTS
	int "Join attempts before giving up"
	default 10

config LPWAN_SHIELD_LORA_TX_OFFSET_DB
	int "TX power offset of the RF path, dB"
	default -2
	help
	  Compensation for the shield's RF switch and matching, found during commissioning.

endif # LPWAN_SHIELD_LORA

config LPWAN_SHIELD_SEND_TIMEOUT_S
	int "Time for a send to report its result before it is failed, s"
	default 45
	help
	  Without a tx_done the state machine would stay in SENDING and every later send would be refused.
	  Used when the backend has no estimate (LTE). A LoRa send is given the time the LR1121 needs (duty-cycle wait,
	  transmissions with their repeats, at most 10 min) plus 5 s, if that is longer. While the LR1121 still holds the
	  frame the send is not failed then; the LR1121 is reset after twice that time. The client waits 15 s more at the least
	  (SENSEI_LPWAN_TX_TIMEOUT_S, 60 s), so this side answers first.

config LPWAN_SHIELD_DFU
	bool "Update over the air: the app (MCUboot) and the modem firmware (delta)"
	default y
	depends on BOOTLOADER_MCUBOOT
	select FLASH
	select FLASH_MAP
	select STREAM_FLASH
	select IMG_MANAGER
	help
	  The nRF5340 sends the new image over the SPI link (lpwan.proto, dfu_* requests); the app writes it into the
	  second MCUboot slot, or hands a delta patch to the modem. The new app confirms itself after the handshake with the
	  nRF5340 (dfu_confirm). Needs MCUboot from sysbuild (sysbuild.conf). See README.md.

config LPWAN_SHIELD_MODEM_DFU
	bool "Modem firmware update (nrf_modem_delta_dfu)"
	default y
	depends on LPWAN_SHIELD_DFU && LPWAN_SHIELD_LTE

config LPWAN_SHIELD_CONFIRM_DELAY_S
	int "Run time before a new app image confirms itself, s"
	default 5
	range 1 600
	depends on LPWAN_SHIELD_DFU
	help
	  After an update the image runs on trial. It confirms itself when it has run this long and the nRF5340 has
	  accepted the handshake (dfu_confirm, sent after the protocol version matched).

config LPWAN_SHIELD_TRIAL_TIMEOUT_S
	int "Trial time of a new app image, s"
	default 180
	range 30 3600
	depends on LPWAN_SHIELD_DFU
	help
	  If the image is still unconfirmed after this time (the nRF5340 did not accept it), the shield resets and MCUboot
	  goes back to the old image. Any reset or power cycle of an unconfirmed image does the same.

config LPWAN_SHIELD_LINK_STACK
	int "SPI link thread stack size"
	default 3072 if LPWAN_SHIELD_DFU
	default 2048
	help
	  The update runs on this thread (flash writes, the read-back hash): it needs the larger size.

config LPWAN_SHIELD_LINK_PRIO
	int "SPI link thread priority (preemptible, lower is higher)"
	default 2

config LPWAN_SHIELD_WORKER_PRIO
	int "Priority of the LTE and LoRa workers (lower is higher)"
	default 6

config LPWAN_SHIELD_LOG_LEVEL
	int "Log level of the service modules (0 off ... 4 debug)"
	default 3

# A modem fault resets the chip (main.c). The choice is only there with the modem library.
choice NRF_MODEM_LIB_ON_FAULT
	default NRF_MODEM_LIB_ON_FAULT_APPLICATION_SPECIFIC
endchoice

source "Kconfig.zephyr"
