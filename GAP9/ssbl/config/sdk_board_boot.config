# The boot area only (FSBL, SSBL, tables): for a board whose slots must stay (make flash-boot of a node). As sdk_board.config.
# SSBL: upper L2 (the app loads below it), MRAM, CRC32 check of the sections, no output on the board.
CONFIG_LINKER_SCRIPT_UPPER_MEMORY=y
CONFIG_FLASH_LAYOUT_CUSTOM=y
CONFIG_FLASH_LAYOUT_PATH="../layouts/sensei_ab_boot.json"
CONFIG_PLATFORM_BOARD=y
CONFIG_DRIVER_MX25U51245G_BAUDRATE_DEFAULT=y
CONFIG_DRIVER_CRC32=y
# The SPI master of the recovery (SENSEI_SSBL_RECOVERY, src/recovery_link.c); not linked without it.
CONFIG_DRIVER_SPIM=y
# The main stack: the update writer of the recovery needs more than the default (hashes, nanopb messages).
CONFIG_FC_APP_MAIN_STACK_SIZE=8192
CONFIG_IO_TYPE_DISABLED=y
# The board flash target writes the MRAM image of the custom layout (FSBL, this SSBL, tables, slots). The documented
# flash flow of the GAP SDK (doc/source/guides/flashing.rst) names the device that the application boots from:
# MRAM, as the application's own config does. With JTAG, gapy would only set boot.mode=jtag and leave out
# boot.flash_device=mram (utils/cmake/macros.cmake); the files written to the MRAM are the same either way.
CONFIG_BOOT_DEVICE_MRAM=y
