/* RAM like the nRF5340 application core: 256 kB of zephyr,sram at 0x20000000 (the RAM of the chip is 512 kB, 8 banks of
 * 64 kB; the SENSEI boards keep the retained RAM and the shared memory above the chosen RAM). */
/ {
	test_sram: memory@20000000 {
		compatible = "mmio-sram";
		reg = <0x20000000 0x40000>;
	};

	chosen {
		zephyr,sram = &test_sram;
	};
};
