#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	sensei_pwr: sensei_pwr {
		compatible = "gpio-leds";
		gpio_gap9_pwr: gpio_gap9_pwr {
			gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
			label = "GAP9_pwr_sel";
		};
		gpio_led_pwr: gpio_led_pwr {
			gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
			label = "LED_EN";
		};
		gpio_ram_pwr: gpio_ram_pwr {
			gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
			label = "nRF_RAM_pwr_sel";
		};
	};
	sensei_irq: sensei_irq {
		compatible = "gpio-keys";
		debounce-interval-ms = <0>;
		/* Both lines idle high. The internal pull-up is in case the board has none (nIRQ is open drain). */
		gpio_pmic_irq: gpio_pmic_irq {
			gpios = <&gpio0 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "PMIC_nIRQ";
		};
		gpio_soft_nrst: gpio_soft_nrst {
			gpios = <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Soft_nRST";
		};
	};
	sensei_comm: sensei_comm {
		compatible = "gpio-leds";
		gpio_gap9_i2c_ctrl: gpio_gap9_i2c_ctrl {
			gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
			label = "I2C_GAP_SEL";
		};
		gpio_gap9_spi_ctrl: gpio_gap9_spi_ctrl {
			gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
			label = "SPI_GAP_SEL";
		};
		gpio_gap9_shared_ctrl: gpio_gap9_shared_ctrl {
			gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
			label = "SHARED_GPIOs_SEL";
		};
		gpio_gap9_irq: gpio_gap9_irq {
			gpios = <&gpio1 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "GAP9_nIRQ";
		};
		/* CS_nRF_GAP, wired straight to GAP9 pad 56: the boot slot (low A, high B), read by the SSBL. */
		gpio_gap9_slot_sel: gpio_gap9_slot_sel {
			gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
			label = "GAP9_slot_sel";
		};
		/* EXT_RX_SPI, wired straight to GAP9 pad 57: the recovery strap (high: the SSBL enters recovery). Used only
		 * with CONFIG_SENSEI_GAP9_RECOVERY_STRAP; UNVERIFIED hardware. */
		gpio_gap9_recovery: gpio_gap9_recovery {
			gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
			label = "GAP9_recovery_strap";
		};
	};

	rtt0: rtt_chan0 {
		compatible = "segger,rtt-uart";
	};

	buttons {
		compatible = "gpio-keys";
		/* SW3 on the base board (nRF_btn). The pull-up is internal in case the board has none. */
		button0: button0 {
			label = "nRF_btn";
			gpios = <&gpio0 25 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};


	aliases {
		sw0 = &button0;
		mcuboot-button0 = &button0;
		watchdog0 = &wdt0;
	};
};
