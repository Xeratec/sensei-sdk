CONFIG_PLATFORM_BOARD=y
# CONFIG_PLATFORM_GVSOC=y

# Board clock tree. These MUST match the SENSEI hardware: the printf UART is
# brought up before main() and its baud divider is derived from
# CONFIG_FREQUENCY_PERIPH, which in turn depends on the real reference
# oscillator (CONFIG_FAST_OSC_FREQUENCY). If these are left at the generic SDK
# defaults, the actual bit rate will not be 115200 and the nRF reports a steady
# stream of framing errors (UART_RX error reason 0x04), even though
# CONFIG_IO_UART_BAUDRATE says 115200.
CONFIG_FAST_OSC_FREQUENCY=24576063
CONFIG_FLL_MAXDCO_FREQ=900000000
CONFIG_FREQUENCY_PERIPH=160000000
CONFIG_FREQUENCY_FC=50000000
CONFIG_FREQUENCY_CLUSTER=50000000
CONFIG_FREQUENCY_SFU=50000000
CONFIG_FREQUENCY_FPGA=50000000

# UART driver (UART0 is wired to the nRF on the SENSEI board).
CONFIG_DRIVER_UART0=y
CONFIG_DRIVER_UDMAUART=y

# Route stdout/printf to UART0 so that everything the GAP9 prints is sent to
# the nRF, which forwards it to its USB console. Note: JTAG semihosting can
# only be used when booting from JTAG and would hang when booting from flash.
CONFIG_IO_TYPE_UART=y
# CONFIG_IO_TYPE_JTAG=y
# CONFIG_IO_TYPE_DISABLED=y

# Baud rate of the printf UART. MUST match the nRF `uart_gap` node
# (current-speed = <115200> in the board DTS). If this is left unset, the GAP
# SDK default is used, which does NOT match the nRF and causes framing errors.
CONFIG_IO_UART_BAUDRATE=115200
