# SSBL: upper L2 (the app loads below it), MRAM, CRC32 check of the sections, no output on the board.
CONFIG_LINKER_SCRIPT_UPPER_MEMORY=y
CONFIG_FLASH_LAYOUT_CUSTOM=y
CONFIG_FLASH_LAYOUT_PATH="../layouts/sensei_ab.json"
CONFIG_PLATFORM_GVSOC=y
CONFIG_DRIVER_MX25U51245G_BAUDRATE_DEFAULT=y
CONFIG_DRIVER_CRC32=y
# The SPI master of the recovery (SENSEI_SSBL_RECOVERY, src/recovery_link.c); not linked without it.
CONFIG_DRIVER_SPIM=y
# The main stack: the update writer of the recovery needs more than the default (hashes, nanopb messages).
CONFIG_FC_APP_MAIN_STACK_SIZE=8192
CONFIG_IO_TYPE_SEMIHOSTING=y
CONFIG_BOOT_DEVICE_JTAG=y
