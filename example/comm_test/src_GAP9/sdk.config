CONFIG_DRIVER_I2C=y

CONFIG_PLATFORM_BOARD=y
# CONFIG_PLATFORM_GVSOC=y

# Disable JTAG Semihosting as, this mode ONLY can be used when boot from JTAG,
# it will cause the process hang if it’s used in boot from flash.
# CONFIG_IO_TYPE_DISABLED=y
# CONFIG_IO_TYPE_UART=y
CONFIG_IO_TYPE_JTAG=y

CONFIG_IO_PRINTF_FLOAT_ENABLE=y
CONFIG_PI_LOG_LEVEL_TRACE=y
CONFIG_APP_LOG=y
CONFIG_DRIVER_NRFSPI_LOG=y

CONFIG_BOARD_SENSEI_BASEV1=y