 / {
    gpio_external {
        compatible = "gpio-keys";
        gpio_ext_gpio0: pca6416a_20p0 {
            gpios = <&pca6416a_20 0 GPIO_ACTIVE_HIGH>;
        };
        gpio_ext_gpio1: pca6416a_20p1 {
            gpios = <&pca6416a_20 1 GPIO_ACTIVE_HIGH>;
        };
        gpio_ext_gpio2: pca6416a_20p2 {
            gpios = <&pca6416a_20 2 GPIO_ACTIVE_HIGH>;
        };
        gpio_ext_gpio3: pca6416a_20p3 {
            gpios = <&pca6416a_20 3 GPIO_ACTIVE_HIGH>;
        };
        gpio_ext_as7331_ready: pca6416a_20p4 {
            gpios = <&pca6416a_20 4 GPIO_ACTIVE_HIGH>;
        };
        /* Camera clock gate. The pin is active low in this tree: logical active (pin low) gates the clock,
         * logical inactive runs it. The hog below gates it from the moment the expander starts. */
        gpio_ext_hm0360_clk_en: pca6416a_20p5 {
            gpios = <&pca6416a_20 5 GPIO_ACTIVE_LOW>;
        };
        gpio_ext_hm0360_meter: pca6416a_20p6 {
            gpios = <&pca6416a_20 6 GPIO_ACTIVE_HIGH>;
        };
        gpio_ext_i2c_sgp41_en: pca6416a_20p7 {
            gpios = <&pca6416a_20 7 GPIO_ACTIVE_HIGH>;
        };
        gpio_ext_imu_spi_int1: pca6416a_20p8 {
            gpios = <&pca6416a_20 8 GPIO_ACTIVE_HIGH>;
        };
        gpio_ext_imu_spi_int2: pca6416a_20p9 {
            gpios = <&pca6416a_20 9 GPIO_ACTIVE_HIGH>;
        };
        gpio_ext_i2c_as7331_en: pca6416a_20p10 {
            gpios = <&pca6416a_20 10 GPIO_ACTIVE_HIGH>;
        };
        gpio_ext_bh1730_int: pca6416a_20p11 {
            gpios = <&pca6416a_20 11 GPIO_ACTIVE_HIGH>;
        };
        gpio_ext_i2c_scd41_en: pca6416a_20p12 {
            gpios = <&pca6416a_20 12 GPIO_ACTIVE_HIGH>;
        };
        gpio_ext_m10q_nrst: pca6416a_20p13 {
            gpios = <&pca6416a_20 13 GPIO_ACTIVE_LOW>;
        };
        gpio_ext_m10q_pio4: pca6416a_20p14 {
            gpios = <&pca6416a_20 14 GPIO_ACTIVE_HIGH>;
        };
        gpio_ext_m10q_pio5: pca6416a_20p15 {
            gpios = <&pca6416a_20 15 GPIO_ACTIVE_HIGH>;
        };
    };

	/*
	 * Power switches of the sensors. The rails are nRF5340 GPIOs (P0.04, P0.05), the I2C isolation switches
	 * sit on the expander (P7, P10, P12). The sensor drivers enable them through vdd-supply and
	 * bus-switch-supply when a sensor is resumed (pm_device_runtime_get) and disable them when it is
	 * suspended. The startup delays are the power-up waits of the sensors. The gpio_scd41_pwr, gpio_sgp41_pwr
	 * and gpio_ext_i2c_* labels name the same pins for code that drives them directly; do not use both ways in
	 * one application. The debug board shield uses P0.04 and P0.05 too: disable these regulators with it.
	 */
	scd41_vdd: regulator-scd41-vdd {
		compatible = "regulator-fixed";
		regulator-name = "scd41-vdd";
		enable-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <1000000>; /* power-up time of the SCD4x, datasheet 3.1 */
	};

	scd41_i2c_sw: regulator-scd41-i2c-sw {
		compatible = "regulator-fixed";
		regulator-name = "scd41-i2c-sw";
		enable-gpios = <&pca6416a_20 12 GPIO_ACTIVE_HIGH>;
	};

	sgp41_vdd: regulator-sgp41-vdd {
		compatible = "regulator-fixed";
		regulator-name = "sgp41-vdd";
		enable-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <50000>;
	};

	sgp41_i2c_sw: regulator-sgp41-i2c-sw {
		compatible = "regulator-fixed";
		regulator-name = "sgp41-i2c-sw";
		enable-gpios = <&pca6416a_20 7 GPIO_ACTIVE_HIGH>;
	};

	as7331_i2c_sw: regulator-as7331-i2c-sw {
		compatible = "regulator-fixed";
		regulator-name = "as7331-i2c-sw";
		enable-gpios = <&pca6416a_20 10 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <10000>;
	};

	sensei_pwr: sensei_pwr {
		compatible = "gpio-leds";
		gpio_scd41_pwr: gpio_scd41_pwr {
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
			label = "SCD41_pwr_sel";
		};
		gpio_sgp41_pwr: gpio_sgp41_pwr {
			gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
			label = "SGP41_pwr_sel";
		};

        gpio_debug_signal_1: gpio_debug_signal_1 {
            gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
            label = "DEBUG_SIGNAL_1";
        };
        gpio_debug_signal_2: gpio_debug_signal_2 {
            gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
            label = "DEBUG_SIGNAl_1";
        };
	};
};

&i2c0 {
	status = "okay";
	/* BME688 on I2C_A, 0x76. Not power gated. Driver in NRF/drivers/sensor (Bosch API, forced mode). */
	bme688: bme688@76 {
		compatible = "bosch,bme688";
		reg = <0x76>;
		status = "okay";
	};

	/*
	 * ISM330DHCX IMU. The shield schematic puts it on I2C_A (i2c0), SA0 low, so 0x6A. INT1 and
	 * INT2 go to expander pins 8 and 9, which are not wired to an interrupt line: polling only.
	 * Zephyr driver (needs hal_st). Both sensors are powered down until an odr is set.
	 */
	ism330dhcx: ism330dhcx@6a {
		compatible = "st,ism330dhcx";
		reg = <0x6a>;
	};
};

&i2c1 {
	status = "okay";
    pca6416a_20: pca6416a@20 {
        compatible = "nxp,pca6416";
        reg = < 0x20 >;
        gpio-controller;
        ngpios = < 16 >;
        #gpio-cells = < 2 >;

        /* HM0360 camera clock off (gated) until the GAP9 camera job needs it. */
        hm0360-clk-gate-hog {
            gpio-hog;
            gpios = <5 GPIO_ACTIVE_LOW>;
            output-high;
        };
    };

    /* SCD41 CO2 sensor on I2C_B, 0x62: rail P0.04, bus switch P12. Driver in NRF/drivers/sensor. */
    scd41: scd41@62 {
        compatible = "sensei,scd41";
        reg = <0x62>;
        vdd-supply = <&scd41_vdd>;
        bus-switch-supply = <&scd41_i2c_sw>;
    };

    /* SGP41 VOC and NOx sensor on I2C_B, 0x59: rail P0.05, bus switch P7. */
    sgp41: sgp41@59 {
        compatible = "sensirion,sgp41";
        reg = <0x59>;
        vdd-supply = <&sgp41_vdd>;
        bus-switch-supply = <&sgp41_i2c_sw>;
    };

    /* AS7331 UV sensor on I2C_B, 0x74: no rail switch, bus switch P10, READY on P4. */
    as7331: as7331@74 {
        compatible = "ams,as7331";
        reg = <0x74>;
        bus-switch-supply = <&as7331_i2c_sw>;
        ready-gpios = <&pca6416a_20 4 GPIO_ACTIVE_HIGH>;
    };

    /* BH1730FVC light sensor on I2C_B, 0x29. No switch: software power-down. */
    bh1730: bh1730@29 {
        compatible = "sensei,bh1730";
        reg = <0x29>;
    };

    /* ILPS28QSW pressure sensor on I2C_B, 0x5C. Not power gated. Driver in NRF/drivers/sensor. */
    ilps28qsw: ilps28qsw@5c {
        compatible = "st,ilps28qsw";
        reg = <0x5c>;
    };

    /* MAX-M10S GNSS, driver in NRF/drivers/gnss. RESET_N, TIMEPULSE (also SAFEBOOT_N, keep it an
     * input) and EXTINT are on the expander. SAFEBOOT_N itself has no net on the shield. */
    gnss: gnss@42 {
        compatible = "u-blox,max-m10s";
        reg = <0x42>;
        reset-gpios = <&pca6416a_20 13 GPIO_ACTIVE_LOW>;
        timepulse-gpios = <&pca6416a_20 14 GPIO_ACTIVE_HIGH>;
        extint-gpios = <&pca6416a_20 15 GPIO_ACTIVE_HIGH>;
        /* No traffic or fixes until the application wakes the module. */
        standby-at-boot;
    };
};
