+/*
+ * Save in tick_timer the time (in us) of the next COUNTER increment, if TICK is enabled and the RTC runs
+ */
+static void update_tick_timer(uint rtc) {
+  struct rtc_status *this = &nhw_rtc_st[rtc];
+  uint64_t match_sub_us; // Only to comply to the interface
+
+  this->tick_timer = TIME_NEVER;
+  if (this->running == false || !((NRF_RTC_regs[rtc].EVTEN | this->INTEN) & RTC_EVTEN_TICK_Msk)) {
+    return;
+  }
+  nhw_rtc_update_COUNTER(rtc);
+  this->tick_timer = get_counter_match_time(rtc, (NRF_RTC_regs[rtc].COUNTER + 1) & RTC_COUNTER_MASK, &match_sub_us);
+}
+
 /**
  * TASK_START triggered handler
  */
