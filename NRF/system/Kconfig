menu "System"

menuconfig SENSEI_COMM
	bool "Enable the SENSEI Communication Subsystem"
	default n
	depends on SENSEI
	help
	  Enable the SENSEI Communication Subsystem.

menuconfig SENSEI_PWR
	bool "Enable the SENSEI Power Subsystem"
	default n
	depends on SENSEI
	help
	  Enable the SENSEI Power Subsystem.

config SENSEI_SDK_VENDOR_COPIES
	bool "Build the SDK's own Bosch and Sensirion library copies"
	default y
	help
	  The SDK carries its own copies of the Bosch BME68x and the Sensirion SCD4x, SGP41 and
	  common libraries for the sensor shield. Turn this off if the application brings the upstream
	  libraries, to avoid duplicate symbols.

rsource "crypto/Kconfig"

endmenu
