config SENSEI_LINK
	bool "SENSEI link layer (framing and protobuf glue)"
	select NANOPB
	help
	  COBS and CRC-16 byte-stream framing, the SPI frame header, fragmentation, the nanopb helpers and
	  the SDK messages (lpwan.proto, types.proto). The generated sources are committed; the nanopb
	  runtime is the one of the NCS nanopb module (same commit as the SDK submodule, see README).

config SENSEI_SPI_MAX_PAYLOAD
	int "Largest payload of an SPI frame, bytes"
	depends on SENSEI_LINK
	default 8192
	range 1048 65535
	help
	  Longest message in one SPI frame (GAP9 jobs and results, LPWAN messages). Frames above it are
	  refused. Set the same value for every program that talks over the link.
