config SENSEI_SECURE
	bool "SENSEI end-to-end envelope (ECDH P-256, HKDF, AES-128-GCM)"
	depends on SENSEI
	select SENSEI_CRYPTO
	select SENSEI_CRYPTO_AEAD
	select SENSEI_CRYPTO_ECDH
	select SENSEI_CRYPTO_HKDF
	help
	  Envelope library on the SENSEI SDK crypto library (lib/sensei_secure/README.md).

config SENSEI_SECURE_SETTINGS
	bool "Keep the end-to-end keys and counters in the settings subsystem"
	depends on SENSEI_SECURE
	select SETTINGS
	help
	  Storage backend of sensei_e2e (sensei_e2e_settings.h): key pair, collector key, counters.

config SENSEI_SECURE_SETTINGS_PREFIX
	string "Settings key prefix"
	default "sensei_comm"
	depends on SENSEI_SECURE_SETTINGS
	help
	  The keys are <prefix>/e2e_priv, e2e_bpub, e2e_tx, e2e_rxs and e2e_rxf. The default is the prefix
	  of the SENSEI IEQ node: a node that updates keeps its keys. Changing it makes stored keys
	  unreachable (a new key pair is made, the collector has to be provisioned again).
