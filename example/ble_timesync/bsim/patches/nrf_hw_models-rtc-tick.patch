 #if (NHW_HAS_DPPI)
@@ -173,6 +177,7 @@ static void nhw_rtc_init(void) {
     for (int j = 0 ; j < rtc_st->n_CCs ; j++) {
       rtc_st->cc_timers[j] = TIME_NEVER;
     }
+    rtc_st->tick_timer = TIME_NEVER;
     rtc_st->overflow_timer = TIME_NEVER;
