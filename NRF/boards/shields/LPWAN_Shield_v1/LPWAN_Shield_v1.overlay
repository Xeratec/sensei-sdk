/*
 * SENSEI LPWAN shield, nRF5340 side (base board nrf5340_senseiv1).
 *
 * Connections (shield J1/J2 to the base board, see firmware/nrf9151/HARDWARE.md):
 * - SPI_A (P0.08 SCK, P0.09 MOSI, P0.10 MISO, P0.11 CS) to the nRF9151 SPI slave. These pins are
 *   SPIM4 pins and are shared with GAP9 (SPIS3) behind a TMUX1112 switch controlled by SPI_GAP_SEL
 *   (P0.20). Only one of the two may own the bus at a time.
 * - I2C_A (P1.02 SCL, P1.03 SDA) to the shield I/O expander TCAL6408 (address 0x20).
 * - Expander interrupt on P1.12 (the base board net MSP_CS).
 * - Event line from the nRF9151 on P0.31.
 * - nRF21540 TX_EN on P0.27 and RX_EN on P1.13 (not used by the firmware yet). Its power-down nPD and MODE are on the
 *   expander (P5, P6): the client holds both low while the extender is not in use (the default).
 * - Without a shield the expander does not answer: its driver stays down and the client never starts (the node uses
 *   BLE for its uplinks).
 */

&pinctrl {
	spi4_lpwan_default: spi4_lpwan_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
				<NRF_PSEL(SPIM_MOSI, 0, 9)>,
				<NRF_PSEL(SPIM_MISO, 0, 10)>;
		};
	};

	spi4_lpwan_sleep: spi4_lpwan_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
				<NRF_PSEL(SPIM_MOSI, 0, 9)>,
				<NRF_PSEL(SPIM_MISO, 0, 10)>;
			low-power-enable;
		};
	};
};

&i2c0 {
	status = "okay";

	/* TCAL6408 (pin compatible with the PCAL6408A driver), ADDR tied to GND. */
	lpwan_expander: tcal6408@20 {
		compatible = "nxp,pcal6408a";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
		int-gpios = <&gpio1 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};

&spi4 {
	status = "okay";
	pinctrl-0 = <&spi4_lpwan_default>;
	pinctrl-1 = <&spi4_lpwan_sleep>;
	pinctrl-names = "default", "sleep";
	/* The client drives the chip select itself (P0.11) so it can release it with the bus. */
	cs-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;

	lpwan_nrf9151: lpwan-nrf9151@0 {
		compatible = "sensei,lpwan-nrf9151";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(4)>;
	};
};

/ {
	lpwan_link: lpwan_link {
		compatible = "sensei,lpwan-link";
		/* nRF9151 P0.15 through the level shifter (shield J1.2). */
		event-gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
		/* Expander P2 (read over I2C). */
		busy-gpios = <&lpwan_expander 2 GPIO_ACTIVE_HIGH>;
		/* Expander P0 (output). */
		ack-gpios = <&lpwan_expander 0 GPIO_ACTIVE_HIGH>;
		/* Expander P1 (output). */
		spare-gpios = <&lpwan_expander 1 GPIO_ACTIVE_HIGH>;
		/* Expander P4: shield 3.3 V load switch. A 1 M pull-up keeps it on until driven low. */
		power-gpios = <&lpwan_expander 4 GPIO_ACTIVE_HIGH>;
		/* Expander P7: output enable of the TXB0108 level shifter (low = off). */
		level-shifter-gpios = <&lpwan_expander 7 GPIO_ACTIVE_HIGH>;
		/* Expander P3: buck-boost mode (high = forced PWM, low = power save). */
		bb-mode-gpios = <&lpwan_expander 3 GPIO_ACTIVE_HIGH>;
		/* Expander P5: nRF21540 range extender power-down nPD (low = off). The client drives it low at every
		 * bring-up and power-off unless CONFIG_SENSEI_LPWAN_FEM is set, so the unused extender is off. */
		fem-pd-gpios = <&lpwan_expander 5 GPIO_ACTIVE_HIGH>;
		/* Expander P6: nRF21540 MODE. Driven low with the extender off, so the line never floats. */
		fem-mode-gpios = <&lpwan_expander 6 GPIO_ACTIVE_HIGH>;
		/* GAP9 isolation switch (TMUX1112) on SPI_A. */
		spi-gap-sel-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
	};

	aliases {
		lpwan-link = &lpwan_link;
		lpwan-spi = &lpwan_nrf9151;
	};
};
